<audio id="song" loop preload="none"></audio>

<script>
/* ==========================================================
   CONFIG: everything personal lives here. Edit freely.
   - name:       their name (also works as index.html?name=Moturam)
   - song:       optional path to a recording you own, e.g. "our-song.mp3".
                 Leave "" to use the built-in waltz.
   - memories:   title, caption, and image path or URL ("" shows a placeholder)
   - voiceNote:  path to an audio file, e.g. "voice.mp3" ("" hides the section)
   - letter:     paragraphs of your letter. {name} is replaced automatically.
   - finale:     the surprise shown after the wish button
   - dates:      the date types to choose from
   - wishes:     quotes that change every time a button is clicked
   ========================================================== */
const CONFIG = {
  name: "Moturam",
  song: "",
  memories: [
    { title: "Your laugh",        caption: "The sound I would choose over any song, on any ordinary day.", image: "" },
    { title: "Your kindness",     caption: "You make people feel seen, and that is one of the things I love most.", image: "" },
    { title: "Our small moments", caption: "The little everyday memories that quietly mean the most to me.", image: "" }
  ],
  voiceNote: "",
  letter: [
    "Happy birthday, {name}. I wanted to write this slowly, because you deserve more than a quick message on a busy day.",
    "There is a quiet kind of happiness that comes from simply being near you. It is in the way you laugh at small things, the way you notice when someone around you is tired, and the way an ordinary afternoon becomes the best part of my week.",
    "I am grateful for every version of you I have been lucky enough to know: the patient you, the brave you, and the you who makes even hard days feel lighter.",
    "So today, I hope this new year gives you slow mornings, good food, friends who make you laugh until you cry, and every dream you have been quietly carrying. I hope you let yourself have them without apologising for wanting them.",
    "Thank you for being exactly who you are. I love you more than these words can carry, and I am so glad I get to celebrate you."
  ],
  finale: {
    title: "Your surprise",
    text: "I have a little plan for us. Choose the kind of date you'd love, pick the day, and I'll keep it safe for us."
  },
  dates: [
    { id: "delhi", sym: "✦", title: "A Delhi date",    text: "Chandni Chowk chaat, a slow walk through Lodhi Garden, and chai as the evening settles." },
    { id: "food",  sym: "❀", title: "A food date",     text: "Dinner at a place you've been wanting to try, with a dessert we'll happily share." },
    { id: "movie", sym: "☾", title: "A movie date",    text: "Your pick of film, a big tub of popcorn, and a late drive home with the windows down." },
    { id: "shop",  sym: "♡", title: "A shopping date", text: "Browse wherever you like, then coffee together and a small gift you choose for yourself." }
  ],
  wishes: [
    "May this year bring you the kind of happiness you always give to everyone else.",
    "Another year of you, and the world is still lucky to have you in it.",
    "Wishing you laughter that hurts your cheeks and dreams that come true.",
    "Here's to a year full of good surprises and even better days.",
    "May every candle on your cake carry a wish you've been holding in your heart.",
    "You deserve all the gentleness and joy you so generously share with others.",
    "May your heart stay as warm as it is, and your year be as lovely as you are.",
    "Wishing you mornings full of peace and evenings full of love.",
    "May the year ahead surprise you with everything you've been quietly hoping for.",
    "Happy birthday. The world is a little brighter because you're in it.",
    "Make a wish, my love. I'm cheering for every single one of them.",
    "Like roses after rain, may your year bloom in ways that take your breath away."
  ]
};

/* ============ Helpers ============ */
const $ = s => document.querySelector(s);
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const fine = matchMedia('(pointer:fine)').matches && !reduce;
const rnd = (a, b) => a + Math.random() * (b - a);
const centerOf = el => { const r = el.getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2]; };
const pad2 = n => String(n).padStart(2, '0');

let name = (new URLSearchParams(location.search).get('name') || CONFIG.name || '').trim().slice(0, 32);
const nameOr = fallback => name || fallback;

function splitChars(el) {
  const text = el.textContent;
  el.textContent = '';
  [...text].forEach((c, i) => {
    const s = document.createElement('span');
    s.className = 'ch';
    s.style.setProperty('--i', i);
    s.textContent = c === ' ' ? '\u00a0' : c;
    el.append(s);
  });
}
function splitWords(el) {
  const words = el.textContent.split(' ');
  el.textContent = '';
  words.forEach((w, i) => {
    const s = document.createElement('span');
    s.className = 'wd';
    s.style.setProperty('--i', i);
    s.textContent = w;
    el.append(s, ' ');
  });
}
splitChars($('#line1'));
splitWords($('#subhead'));

/* ============ Intro: waits for her tap, which also starts the music ============ */
const intro = $('#intro');
function finishIntro() {
  if (intro.classList.contains('done')) return;
  intro.classList.add('done');
  document.body.classList.add('go');
}
if (reduce) { intro.remove(); document.body.classList.add('go'); }
else {
  intro.addEventListener('click', () => { finishIntro(); startSong(); });
}

/* ============ Floating glows ============ */
if (!reduce) {
  const layer = $('#orbs');
  for (let i = 0; i < 10; i++) {
    const o = document.createElement('i');
    o.className = 'orb';
    const s = rnd(10, 46);
    o.style.width = s + 'px';
    o.style.height = s + 'px';
    o.style.left = rnd(0, 100) + '%';
    o.style.top = rnd(0, 100) + '%';
    o.style.animationDuration = rnd(10, 22) + 's';
    o.style.animationDelay = -rnd(0, 20) + 's';
    o.style.setProperty('--dx', rnd(-90, 90) + 'px');
    o.style.setProperty('--dy', rnd(-130, 130) + 'px');
    layer.append(o);
  }
}

/* ============ Pre-drawn rose, flower and petal sprites ============ */
function sprite(size, draw) {
  const c = document.createElement('canvas');
  c.width = c.height = Math.ceil(size * 2);
  const x = c.getContext('2d');
  x.translate(size, size);
  draw(x, size);
  return { c, size };
}
function drawRose(x, s, [outer, mid, inner]) {
  for (let ring = 0; ring < 3; ring++) {
    const n = 5 + ring;
    const r = s * (.95 - ring * .27);
    x.fillStyle = ring === 0 ? outer : ring === 1 ? mid : inner;
    for (let i = 0; i < n; i++) {
      x.save();
      x.rotate(i / n * Math.PI * 2 + ring * .5);
      x.beginPath();
      x.ellipse(0, -r * .45, r * .42, r * .5, 0, 0, Math.PI * 2);
      x.fill();
      x.restore();
    }
  }
  x.fillStyle = 'rgba(70,10,30,.55)';
  x.beginPath(); x.arc(0, 0, s * .22, 0, Math.PI * 2); x.fill();
  x.fillStyle = 'rgba(255,220,200,.35)';
  x.beginPath(); x.arc(-s * .1, -s * .12, s * .08, 0, Math.PI * 2); x.fill();
}
function drawFlower(x, s, petal, center) {
  for (let i = 0; i < 5; i++) {
    x.save();
    x.rotate(i * Math.PI * 2 / 5);
    x.fillStyle = petal;
    x.beginPath();
    x.ellipse(0, -s * .5, s * .28, s * .5, 0, 0, Math.PI * 2);
    x.fill();
    x.restore();
  }
  x.fillStyle = center;
  x.beginPath(); x.arc(0, 0, s * .18, 0, Math.PI * 2); x.fill();
}

const roses = [
  sprite(22, (x, s) => drawRose(x, s, ['#8e2d4c', '#c4566a', '#f08a78'])),
  sprite(22, (x, s) => drawRose(x, s, ['#b83a55', '#d9687a', '#ffd3bd'])),
  sprite(22, (x, s) => drawRose(x, s, ['#6b2140', '#a84a62', '#e6a48f']))
];
const flowers = [
  sprite(14, (x, s) => drawFlower(x, s, '#fff4ec', '#e6c894')),
  sprite(14, (x, s) => drawFlower(x, s, '#f6b8c4', '#d9687a')),
  sprite(14, (x, s) => drawFlower(x, s, '#ffd3bd', '#e6c894'))
];
const petals = [
  sprite(10, (x, s) => {
    x.fillStyle = '#f4a0ae';
    x.beginPath(); x.ellipse(0, 0, s * .45, s * .85, 0, 0, Math.PI * 2); x.fill();
  }),
  sprite(10, (x, s) => {
    x.fillStyle = '#ffd3bd';
    x.beginPath(); x.ellipse(0, 0, s * .45, s * .85, 0, 0, Math.PI * 2); x.fill();
  })
];

/* ============ Canvases: rose & flower rain (behind), click bursts (front) ============ */
const rainCv = $('#rain'), rctx = rainCv.getContext('2d');
const fxCv = $('#fx'), fctx = fxCv.getContext('2d');
let W = 0, H = 0;
function resize() {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  W = innerWidth; H = innerHeight;
  for (const [cv, c] of [[rainCv, rctx], [fxCv, fctx]]) {
    cv.width = W * dpr; cv.height = H * dpr;
    cv.style.width = W + 'px'; cv.style.height = H + 'px';
    c.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
}
resize();
addEventListener('resize', resize);

const rain = [];
let rainTimer = 0;
function rainCap() { return W < 600 ? 36 : 64; }
function spawnRain(initial = false) {
  const r = Math.random();
  const kind = r < .5 ? 'rose' : r < .8 ? 'flower' : 'petal';
  const set = kind === 'rose' ? roses : kind === 'flower' ? flowers : petals;
  const s = set[Math.random() * set.length | 0];
  rain.push({
    s, kind,
    base: kind === 'rose' ? 44 : kind === 'flower' ? 32 : 24,
    sc: rnd(.55, 1.05),
    x: rnd(-20, W + 20),
    y: initial ? rnd(-40, H) : rnd(-90, -30),
    vy: rnd(.8, 1.9),
    rot: rnd(0, Math.PI * 2),
    vr: rnd(-.025, .025),
    sw: rnd(0, Math.PI * 2),
    sa: rnd(.5, 1.2),
    a: rnd(.7, 1)
  });
}
if (!reduce) for (let i = 0; i < 26; i++) spawnRain(true);

const COLORS = ['#f08a78', '#ffd3bd', '#e6c894', '#f4a88f', '#d9687a', '#fff1e6'];
const bursts = [];
function burst(x, y, n = 60) {
  if (reduce) return;
  for (let i = 0; i < n; i++) {
    const a = rnd(0, Math.PI * 2), sp = rnd(2, 9);
    bursts.push({
      x, y,
      vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - rnd(1, 4),
      life: rnd(900, 1500), age: 0,
      s: rnd(2.5, 6), c: COLORS[i % COLORS.length]
    });
  }
}

let last = performance.now();
function frame(now) {
  const dt = Math.min(now - last, 40); last = now;
  const f = dt / 16.67;

  rctx.clearRect(0, 0, W, H);
  if (!reduce && !document.hidden) {
    rainTimer += dt;
    if (rainTimer > 170 && rain.length < rainCap()) { rainTimer = 0; spawnRain(); }
  }
  for (let i = rain.length - 1; i >= 0; i--) {
    const p = rain[i];
    p.sw += .02 * f;
    p.x += Math.sin(p.sw) * p.sa * f * .8;
    p.y += p.vy * f;
    p.rot += p.vr * f;
    if (p.y > H + 60) { rain.splice(i, 1); continue; }
    const d = p.base * p.sc;
    rctx.save();
    rctx.globalAlpha = p.a;
    rctx.translate(p.x, p.y);
    rctx.rotate(p.rot);
    rctx.drawImage(p.s.c, -d / 2, -d / 2, d, d);
    rctx.restore();
  }

  fctx.clearRect(0, 0, W, H);
  for (let i = bursts.length - 1; i >= 0; i--) {
    const p = bursts[i];
    p.age += dt;
    if (p.age > p.life) { bursts.splice(i, 1); continue; }
    const drag = Math.pow(.975, f);
    p.vx *= drag;
    p.vy = p.vy * drag + .16 * f;
    p.x += p.vx * f;
    p.y += p.vy * f;
    const t = p.age / p.life;
    fctx.globalAlpha = Math.max(0, Math.min(1, t < .1 ? t / .1 : 1 - (t - .1) / .9));
    fctx.fillStyle = p.c;
    fctx.beginPath();
    fctx.arc(p.x, p.y, p.s, 0, Math.PI * 2);
    fctx.fill();
  }
  fctx.globalAlpha = 1;

  requestAnimationFrame(frame);
}
if (!reduce) requestAnimationFrame(frame);

/* ============ Cursor glow (desktop) ============ */
if (fine) {
  const g = $('#glow');
  let x = innerWidth / 2, y = innerHeight / 2, tx = x, ty = y;
  addEventListener('pointermove', e => { tx = e.clientX; ty = e.clientY; }, { passive: true });
  (function glowLoop() {
    x += (tx - x) * .12; y += (ty - y) * .12;
    g.style.transform = `translate(${x - 180}px, ${y - 180}px)`;
    requestAnimationFrame(glowLoop);
  })();
} else {
  $('#glow').remove();
}

/* Progress bar & background parallax */
const bar = $('#progress');
const blobs = [...document.querySelectorAll('.blob')];
addEventListener('scroll', () => {
  const el = document.documentElement;
  bar.style.transform = `scaleX(${(el.scrollTop / (el.scrollHeight - el.clientHeight)) || 0})`;
