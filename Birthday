/* ============ Date planner ============
   The choice is saved in the browser, so it stays fixed after the page closes. */
const STORE_KEY = 'birthdayDatePlan';
const REMINDERS = [
  { key: 'day',  before: 864e5, text: "Your date is tomorrow! Get ready, my love ♡" },
  { key: 'hour', before: 36e5,  text: "Your date starts in 1 hour ♡" },
  { key: 'now',  before: 0,     text: "It's date time! Let's go ♡" }
];
let chosenId = null;

function loadPlan() {
  try { return JSON.parse(localStorage.getItem(STORE_KEY)); } catch (e) { return null; }
}
function savePlan(p) {
  try { localStorage.setItem(STORE_KEY, JSON.stringify(p)); } catch (e) {}
}
function optionById(id) {
  return CONFIG.dates.find(d => d.id === id) || CONFIG.dates[0];
}
function formatWhen(d) {
  return d.toLocaleString('en-IN', {
    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    hour: 'numeric', minute: '2-digit'
  });
}
function localDateValue(d) { return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`; }
function localTimeValue(d) { return `${pad2(d.getHours())}:${pad2(d.getMinutes())}`; }

function renderOptions() {
  const box = $('#options');
  box.innerHTML = '';
  CONFIG.dates.forEach(o => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'opt';
    b.dataset.id = o.id;
    b.innerHTML = `<span class="sym">${o.sym}</span><strong></strong><small></small>`;
    b.querySelector('strong').textContent = o.title;
    b.querySelector('small').textContent = o.text;
    b.addEventListener('click', () => selectOption(o.id));
    box.append(b);
  });
}

function selectOption(id) {
  chosenId = id;
  document.querySelectorAll('.opt').forEach(x => x.classList.toggle('sel', x.dataset.id === id));
  updateLockButton();
}

function updateLockButton() {
  const ok = chosenId && $('#dateIn').value;
  $('#lockBtn').disabled = !ok;
  $('#plannerMsg').textContent = !chosenId
    ? 'Choose a date type first.'
    : !$('#dateIn').value
      ? 'Now pick the day and time.'
      : 'Ready. Fixing it keeps this date safe for both of you.';
}

function renderPlanner() {
  const plan = loadPlan();
  const locked = !!plan;
  $('#planner').hidden = locked;
  $('#lockedCard').hidden = !locked;
  if (!plan) return;
  const o = optionById(plan.type);
  $('#lockedTitle').textContent = o.title;
  $('#lockedWhen').textContent = formatWhen(new Date(plan.when));
  tickCountdown();
}

function tickCountdown() {
  const plan = loadPlan();
  if (!plan) return;
  const diff = new Date(plan.when).getTime() - Date.now();
  const el = $('#countdown');
  if (diff <= 0) { el.textContent = "It's date time! ♡"; return; }
  const days = Math.floor(diff / 864e5);
  const hrs = Math.floor(diff % 864e5 / 36e5);
  const mins = Math.floor(diff % 36e5 / 6e4);
  el.textContent = `${days}d ${hrs}h ${mins}m to go`;
}

function showBanner(msg) {
  $('#bannerText').textContent = msg;
  const b = $('#banner');
  b.classList.add('show');
  setTimeout(() => b.classList.remove('show'), 8000);
}
function notify(msg) {
  try {
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification(`For ${nameOr('my love')} ♡`, { body: msg });
    }
  } catch (e) {}
}

function checkReminders() {
  const plan = loadPlan();
  if (!plan) return;
  plan.fired = plan.fired || {};
  const start = new Date(plan.when).getTime();
  const now = Date.now();
  const due = REMINDERS.filter(r => now >= start - r.before && !plan.fired[r.key]);
  if (!due.length) return;
  due.forEach(r => { plan.fired[r.key] = true; });
  savePlan(plan);
  const msg = due[due.length - 1].text;
  showBanner(msg);
  notify(msg);
}

function downloadIcs() {
  const plan = loadPlan();
  if (!plan) return;
  const o = optionById(plan.type);
  const start = new Date(plan.when);
  const end = new Date(start.getTime() + 2 * 36e5);
  const fmt = d => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
  const ics = [
    'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Birthday Surprise//EN',
    'BEGIN:VEVENT',
    `UID:${plan.when}@birthday-surprise`,
    `DTSTAMP:${fmt(new Date())}`,
    `DTSTART:${fmt(start)}`,
    `DTEND:${fmt(end)}`,
    `SUMMARY:${o.title} ♡`,
    `DESCRIPTION:${o.text}`,
    'BEGIN:VALARM', 'TRIGGER:-P1D', 'ACTION:DISPLAY', 'DESCRIPTION:Your date is tomorrow', 'END:VALARM',
    'BEGIN:VALARM', 'TRIGGER:-PT1H', 'ACTION:DISPLAY', 'DESCRIPTION:Your date starts in 1 hour', 'END:VALARM',
    'END:VEVENT', 'END:VCALENDAR'
  ].join('\r\n');
  const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
  const a = document.createElement('a');
  a.href = url;
  a.download = 'our-date.ics';
  document.body.append(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

