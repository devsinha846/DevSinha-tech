/* ============ Background music & lyrics ============
   An original waltz in D major, 3/4 time. It plays quietly in the background
   and starts on the first tap anywhere on the page (browsers require a tap). */
const SONG = {
  bpm: 80,
  lines: [
    { text: "Every morning, sunlight finds your name",   ch: [293.66, 369.99, 440], bass: 146.83,
      notes: [[369.99,1],[440,1],[493.88,2],[440,1],[369.99,1]] },
    { text: "soft as petals, sweet as summer rain",      ch: [246.94, 293.66, 369.99], bass: 123.47,
      notes: [[329.63,1],[369.99,1],[440,2],[392,1],[369.99,1]] },
    { text: "Happy birthday, {name}, my love",           ch: [196, 246.94, 293.66], bass: 98,
      notes: [[587.33,1.5],[587.33,.5],[659.25,1],[587.33,1],[493.88,2]] },
    { text: "every year I'll choose you, every day",     ch: [220, 277.18, 329.63], bass: 110,
      notes: [[493.88,1],[554.37,1],[587.33,1],[659.25,1],[587.33,2]] },
    { text: "Roses bloom for you tonight",               ch: [196, 246.94, 293.66], bass: 98,
      notes: [[739.99,1],[659.25,1],[587.33,2],[493.88,1],[440,1]] },
    { text: "the sweetest gift the world could hold",    ch: [220, 277.18, 329.63], bass: 110,
      notes: [[493.88,1],[554.37,1],[587.33,1],[554.37,1],[493.88,2]] },
    { text: "Happy birthday, {name}, my heart",          ch: [293.66, 369.99, 440], bass: 146.83,
      notes: [[587.33,1.5],[587.33,.5],[659.25,1],[739.99,1],[659.25,2]] },
    { text: "I'm still falling, every day, for you",     ch: [246.94, 293.66, 369.99], bass: 123.47,
      notes: [[587.33,1],[554.37,1],[493.88,1],[440,1],[369.99,2]] }
  ]
};
const BEAT = 60 / SONG.bpm;
const LOOP_SEC = SONG.lines.length * 6 * BEAT;

let ac = null, master = null, verb = null, songOn = false;
let nextStart = 0, schedTimer = null, hlTimers = [], autoTried = false;
const songEl = $('#song');
if (CONFIG.song) songEl.src = CONFIG.song;

function initAudio() {
  if (ac) return;
  ac = new (window.AudioContext || window.webkitAudioContext)();
  master = ac.createGain();
  master.gain.value = 0;
  master.connect(ac.destination);
  verb = ac.createDelay(1.5);
  verb.delayTime.value = .32;
  const fb = ac.createGain(); fb.gain.value = .3;
  const wet = ac.createGain(); wet.gain.value = .28;
  verb.connect(fb).connect(verb);
  verb.connect(wet).connect(master);
}

/* Lead voice: soft triangle and sawtooth with gentle vibrato */
function lead(freq, t, dur) {
  const o1 = ac.createOscillator(), o2 = ac.createOscillator();
  const filt = ac.createBiquadFilter(), g = ac.createGain();
  const lfo = ac.createOscillator(), lfoGain = ac.createGain();
  o1.type = 'triangle'; o2.type = 'sawtooth';
  o1.frequency.value = freq; o2.frequency.value = freq;
  o1.detune.value = 4; o2.detune.value = -6;
  filt.type = 'lowpass'; filt.frequency.value = 2400; filt.Q.value = .6;
  lfo.frequency.value = 5.2;
  lfoGain.gain.setValueAtTime(0, t);
  lfoGain.gain.linearRampToValueAtTime(freq * .006, t + .35);
  lfo.connect(lfoGain); lfoGain.connect(o1.frequency); lfoGain.connect(o2.frequency);
  const peak = .15;
  g.gain.setValueAtTime(0, t);
  g.gain.linearRampToValueAtTime(peak, t + .06);
  g.gain.setValueAtTime(peak * .85, t + Math.max(.1, dur * .75));
  g.gain.linearRampToValueAtTime(0, t + dur + .25);
  o1.connect(filt); o2.connect(filt); filt.connect(g);
  g.connect(master); g.connect(verb);
  const end = t + dur + .3;
  o1.start(t); o2.start(t); lfo.start(t);
  o1.stop(end); o2.stop(end); lfo.stop(end);
}

/* Warm chord pad under each line */
function pad(freqs, t, dur) {
  freqs.forEach(f => {
    const o = ac.createOscillator(), g = ac.createGain();
    o.type = 'sine';
    o.frequency.value = f;
    g.gain.setValueAtTime(0, t);
    g.gain.linearRampToValueAtTime(.035, t + .6);
    g.gain.linearRampToValueAtTime(0, t + dur + .4);
    o.connect(g).connect(master);
    o.start(t);
    o.stop(t + dur + .5);
  });
}

/* Waltz bass: a soft pulse on beat one of each bar */
function bass(freq, t) {
  const o = ac.createOscillator(), g = ac.createGain();
  o.type = 'sine';
  o.frequency.value = freq;
  g.gain.setValueAtTime(0, t);
  g.gain.linearRampToValueAtTime(.16, t + .05);
  g.gain.exponentialRampToValueAtTime(.0001, t + 2.4 * BEAT);
  o.connect(g).connect(master);
  o.start(t);
  o.stop(t + 2.5 * BEAT);
}

function lyricText(t) {
  return t.replace(/\{name\}/g, nameOr('my love'));
}
function renderLyrics() {
  const box = $('#lyrics');
  box.innerHTML = '';
  SONG.lines.forEach((l, i) => {
    const p = document.createElement('p');
    p.className = 'lyric' + (i === 2 || i === 4 || i === 6 ? ' gap' : '');
    p.textContent = lyricText(l.text);
    box.append(p);
  });
}
function highlight(i) {
  document.querySelectorAll('.lyric').forEach((el, j) => el.classList.toggle('on', j === i));
}

/* Schedules one full loop of the waltz starting at nextStart */
function scheduleLoop() {
  const t0 = nextStart;
  let t = t0;
  SONG.lines.forEach((line, i) => {
    const lb = line.notes.reduce((s, n) => s + n[1], 0);
    let nt = t;
    line.notes.forEach(([f, b]) => { lead(f, nt, b * BEAT * .95); nt += b * BEAT; });
    pad(line.ch, t, lb * BEAT);
    for (let k = 0; k < lb / 3; k++) bass(line.bass, t + k * 3 * BEAT);
    hlTimers.push(setTimeout(() => highlight(i), Math.max(0, (t - ac.currentTime) * 1000)));
    t += lb * BEAT;
  });
  nextStart = t0 + LOOP_SEC;
}
/* Keeps about 4 seconds of music scheduled ahead so it never stutters */
function keepAhead() {
  if (!songOn || !ac) return;
  while (nextStart < ac.currentTime + 4) scheduleLoop();
}

async function startSong() {
  if (songOn) return;
  try {
    if (CONFIG.song) {
      songOn = true;
      songEl.volume = .6;
      await songEl.play();
      $('#songNote').textContent = 'Playing your recording.';
    } else {
      initAudio();
      songOn = true;
      if (ac.state !== 'running') await ac.resume();
      master.gain.cancelScheduledValues(ac.currentTime);
      master.gain.setValueAtTime(0, ac.currentTime);
      master.gain.linearRampToValueAtTime(.9, ac.currentTime + 1.2);
      nextStart = ac.currentTime + .2;
      keepAhead();
      clearInterval(schedTimer);
      schedTimer = setInterval(keepAhead, 500);
      $('#songNote').textContent = 'Lyrics light up as the waltz plays.';
    }
    setSongUI(true);
  } catch (err) {
    songOn = false;
    setSongUI(false);
    $('#songNote').textContent = 'Music could not start (' + err.message + '). Tap "Play our song" again.';
  }
}

function stopSong() {
  songOn = false;
  setSongUI(false);
  if (CONFIG.song) { songEl.pause(); return; }
  clearInterval(schedTimer);
  hlTimers.forEach(clearTimeout);
  hlTimers = [];
  if (ac) {
    master.gain.cancelScheduledValues(ac.currentTime);
    master.gain.setTargetAtTime(0, ac.currentTime, .1);
  }
  highlight(-1);
  nextStart = 0;
}

function setSongUI(on) {
  const btn = $('#soundBtn');
  btn.classList.toggle('on', on);
  btn.setAttribute('aria-pressed', String(on));
  $('#soundLabel').textContent = on ? 'Pause our song' : 'Play our song';
}
